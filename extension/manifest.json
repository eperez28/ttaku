{
  "manifest_version": 3,
  "name": "Ttaku \u2014 speak along",
  "version": "1.10.1",
  "description": "Speak fluent Japanese by watching anime.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.crunchyroll.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.meta.ai/*",
    "wss://api.meta.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Start / stop Ttaku",
    "default_popup": "setup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.crunchyroll.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "commands": {
    "capture-phrase": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Hear the last part again"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
